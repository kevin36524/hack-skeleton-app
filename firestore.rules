rules_version = '2';

// The rsvp-navaratri database is only ever accessed through the Admin SDK
// on the server (lib/firebase/admin.ts), which bypasses these rules.
// Client SDK access is denied entirely — the web client talks to the
// Next.js API routes instead, so even a leaked API key is useless here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
